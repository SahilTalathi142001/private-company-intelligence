            },
            {
                "output_field": "valuation_status",
                "source": "STEP20",
                "transformation": "Pass-through; no valuation inference",
                "step21_version": STEP21_VERSION_EXPECTED,
                "dq_version": STEP21_DQ_VERSION,
            },
            {
                "output_field": "screening_eligibility",
                "source": "STEP21",
                "transformation": "DQ re-derives deterministic eligibility rule",
                "step21_version": STEP21_VERSION_EXPECTED,
                "dq_version": STEP21_DQ_VERSION,
            },
            {
                "output_field": "filter_flags",
                "source": "STEP21",
                "transformation": "DQ re-derives deterministic screening booleans",
                "step21_version": STEP21_VERSION_EXPECTED,
                "dq_version": STEP21_DQ_VERSION,
            },
        ]
    )


def build_promotion(
    inputs: dict[str, pd.DataFrame],
    exceptions: list[dict[str, Any]],
    warnings: list[str],
) -> pd.DataFrame:
    fatal = sum(e["severity"] == "FATAL" for e in exceptions)

    return pd.DataFrame(
        [
            {
                "step": "STEP_21.1",
                "audited_step": "STEP_21",
                "step21_version": STEP21_VERSION_EXPECTED,
                "dq_version": STEP21_DQ_VERSION,
                "promotion_decision": "BLOCKED" if fatal else "PROMOTE",
                "company_count": int(inputs["search"]["cik"].nunique()),
                "fatal_exception_count": fatal,
                "warning_count": len(warnings),
                "cross_layer_reconciliation_enforced": True,
                "company_master_coverage_enforced": True,
                "screening_determinism_enforced": True,
                "new_financial_score_created": False,
                "new_ranking_created": False,
                "funding_stage_inference_prevented": True,
                "investor_identity_inference_prevented": True,
                "ownership_inference_prevented": True,
                "valuation_inference_prevented": True,
                "sec_capital_separate_from_valuation": True,
                "valuation_fabrication_prevented": True,
                "generated_at_utc": now(),
            }
        ]
    )


# =============================================================================
# MAIN
# =============================================================================

def main() -> None:
    parser = argparse.ArgumentParser(
        description="Step 21.1 - Company Discovery / Screening DQ"
    )

    parser.add_argument("--search", type=Path, default=STEP21_SEARCH)
    parser.add_argument("--screening", type=Path, default=STEP21_SCREENING)
    parser.add_argument("--summary", type=Path, default=STEP21_SUMMARY)
    parser.add_argument("--lineage", type=Path, default=STEP21_LINEAGE)
    parser.add_argument("--promotion", type=Path, default=STEP21_PROMOTION)

    parser.add_argument(
        "--step16-profile",
        type=Path,
        default=STEP16_PROFILE,
    )
    parser.add_argument(
        "--step20-profile",
        type=Path,
        default=STEP20_PROFILE,
    )
    parser.add_argument(
        "--step20-signals",
        type=Path,
        default=STEP20_SIGNALS,
    )
    parser.add_argument(
        "--company-master",
        type=Path,
        default=COMPANY_MASTER,
    )
    parser.add_argument(
        "--output",
        type=Path,
        default=OUTPUT,
    )

    args = parser.parse_args()

    logger.info("=" * 88)
    logger.info("STEP 21.1 - COMPANY DISCOVERY / SCREENING DATA QUALITY")
    logger.info("DQ version             : %s", STEP21_DQ_VERSION)
    logger.info("Audited Step 21 version: %s", STEP21_VERSION_EXPECTED)
    logger.info("=" * 88)

    inputs = load_inputs(args)

    logger.info("Step 21 search rows : %d", len(inputs["search"]))
    logger.info("Step 21 screening   : %d", len(inputs["screening"]))
    logger.info("Step 21 summary     : %d", len(inputs["summary"]))
    logger.info("Step 21 lineage     : %d", len(inputs["lineage"]))
    logger.info("Step 21 promotion   : %d", len(inputs["promotion"]))
    logger.info("Step 16 profile     : %d", len(inputs["step16"]))
    logger.info("Step 20 profile     : %d", len(inputs["step20"]))
    logger.info("Step 20 signals     : %d", len(inputs["signals"]))
    logger.info("Company master     : %d", len(inputs["master"]))

    exceptions: list[dict[str, Any]] = []

    # Schema/version checks first.
    audit_schema(inputs, exceptions)
    audit_versions(inputs, exceptions)

    # Structural/universe checks.
    audit_company_master_coverage(inputs, exceptions)
    audit_universe_grain(inputs, exceptions)
    audit_universe_alignment(inputs, exceptions)
    audit_identity_consistency(inputs, exceptions)

    # Step 21 business-rule checks.
    audit_allowed_values(inputs, exceptions)
    audit_screening_determinism(inputs, exceptions)
    audit_screening_artifact(inputs, exceptions)

    # Upstream reconciliation.
    audit_reconciliation(inputs, exceptions)
    audit_signal_integrity(inputs, exceptions)

    # Governance / anti-fabrication.
    audit_governance_controls(inputs, exceptions)

    # Summary/lineage/promotion.
    audit_summary(inputs, exceptions)
    audit_lineage(inputs, exceptions)
    audit_promotion(inputs, exceptions)

    warnings = build_warnings(inputs)

    checks = build_validation_checks(exceptions, inputs)
    dq_summary = build_summary(inputs, exceptions, warnings)
    dq_summary.loc[0, "validation_checks"] = len(checks)

    lineage = build_lineage(inputs)
    promotion = build_promotion(inputs, exceptions, warnings)

    output = {
        "checks": (
            args.output
            / "company_intelligence_validation_checks"
            / "company_intelligence_validation_checks.parquet"
        ),
        "exceptions": (
            args.output
            / "company_intelligence_exceptions"
            / "company_intelligence_exceptions.parquet"
        ),
        "summary": (
            args.output
            / "company_intelligence_dq_summary"
            / "company_intelligence_dq_summary.parquet"
        ),
        "lineage": (
            args.output
            / "company_intelligence_dq_lineage"
            / "company_intelligence_dq_lineage.parquet"
        ),
        "promotion": (
            args.output
            / "company_intelligence_promotion"
            / "company_intelligence_promotion.parquet"
        ),
    }

    for path in output.values():
        path.parent.mkdir(parents=True, exist_ok=True)

    checks.to_parquet(output["checks"], index=False)

    exception_df = pd.DataFrame(
        exceptions,
        columns=["check_name", "severity", "message", "cik", "artifact"],
    )

    if exception_df.empty:
        exception_df = pd.DataFrame(
            columns=["check_name", "severity", "message", "cik", "artifact"]
        )

    exception_df["step21_version"] = STEP21_VERSION_EXPECTED
    exception_df["dq_version"] = STEP21_DQ_VERSION
    exception_df["generated_at_utc"] = now()

    exception_df.to_parquet(output["exceptions"], index=False)
    dq_summary.to_parquet(output["summary"], index=False)
    lineage.to_parquet(output["lineage"], index=False)
    promotion.to_parquet(output["promotion"], index=False)

    fatal = sum(e["severity"] == "FATAL" for e in exceptions)

    logger.info("")
    logger.info("=" * 88)
    logger.info("STEP 21.1 SUMMARY")
    logger.info("=" * 88)
    logger.info("Validation checks      : %d", len(checks))
    logger.info("Failed checks          : %d", fatal)
    logger.info("Fatal DQ exceptions    : %d", fatal)
    logger.info("Controlled warnings    : %d", len(warnings))
    logger.info(
        "Promotion decision      : %s",
        "BLOCKED" if fatal else "PROMOTE",
    )
    logger.info("Company master coverage: ENFORCED")
    logger.info("Cross-layer reconcile  : ENFORCED")
    logger.info("Eligibility determinism: ENFORCED")
    logger.info("Financial score         : PASS-THROUGH ONLY")
    logger.info("New financial score     : NO")
    logger.info("New ranking             : NO")
    logger.info("SEC capital != valuation: ENFORCED")
    logger.info("Funding-stage inference : PREVENTED")
    logger.info("Investor identity       : PREVENTED")
    logger.info("Ownership inference     : PREVENTED")
    logger.info("Valuation inference     : PREVENTED")

    for warning in warnings:
        logger.warning(warning)

    logger.info("DQ checks : %s", output["checks"])
    logger.info("Exceptions: %s", output["exceptions"])
    logger.info("Summary   : %s", output["summary"])
    logger.info("Lineage   : %s", output["lineage"])
    logger.info("Promotion : %s", output["promotion"])

    if fatal:
        logger.error(
            "STEP 21.1 FAILED: Step 21 is not DQ-cleared."
        )
        raise RuntimeError(
            f"Step 21.1 blocked promotion with {fatal} fatal DQ exception(s)."
        )

    logger.info("=" * 88)
    logger.info("STEP 21.1 PASS: Company Discovery / Screening is DQ-cleared.")
    logger.info("=" * 88)


if __name__ == "__main__":
    main()
