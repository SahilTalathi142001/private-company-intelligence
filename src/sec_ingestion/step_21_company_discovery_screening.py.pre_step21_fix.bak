VALID_COVERAGE = {"COMPLETE", "PARTIAL", "LIMITED", "NO_DATA"}
VALID_ELIGIBILITY = {"ELIGIBLE", "LIMITED", "INSUFFICIENT_DATA"}

UNIFIED_COMPANY_VIEW = (
    DATA
    / "gold"
